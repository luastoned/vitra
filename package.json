{
  "name": "vitra",
  "version": "0.0.0",
  "private": true,
  "description": "A quick way to get started with React, Chakra UI using Vite, TypeScript",
  "license": "MIT",
  "author": "Gregor Steiner <spacegregor@gmail.com>",
  "repository": "git@github.com:luastoned/vitra.git",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:all": "yarn typecheck && yarn lint && yarn format:check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:eslint": "eslint .",
    "preview": "vite preview",
    "snippets": "npx @chakra-ui/cli snippet add --outdir src/shared/ui/chakra",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.2.2"
  }
}
